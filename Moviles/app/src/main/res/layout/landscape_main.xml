<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ========== GUIDELINES VERTICALES ========== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.025" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verticalfin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.97" />

    <!-- ========== GUIDELINES HORIZONTALES (todas en porcentaje) ========== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.145" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.30" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.43" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.56" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.69" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontalpenultima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.82" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontalfin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.86" />

    <!-- ========== BARRA SUPERIOR ========== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/purple_main"
        app:title="TaskMate"
        app:titleTextColor="@android:color/white"
        app:titleMarginStart="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/horizontal1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/vertical1" />

    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="@id/verticalfin" />

    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@android:color/white"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toStartOf="@id/iv_more" />

    <!-- ========== SALUDO ========== -->
    <TextView
        android:id="@+id/tv_saludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola, Ana 👋"
        android:textColor="#1C1B1F"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/vertical1" />

    <TextView
        android:id="@+id/tv_subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy tienes 3 tareas pendientes"
        android:textColor="@color/grey_text"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tv_saludo"
        app:layout_constraintStart_toStartOf="@id/vertical1" />

    <!-- ========== CHIPS ========== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_completadas"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Completadas"
        android:textColor="@color/grey_text"
        android:backgroundTint="@color/grey_light"
        app:layout_constraintTop_toTopOf="@id/tv_saludo"
        app:layout_constraintEnd_toEndOf="@id/verticalfin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pendientes"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pendientes"
        android:textColor="@color/grey_text"
        android:backgroundTint="@color/grey_light"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/btn_completadas"
        app:layout_constraintBottom_toBottomOf="@id/btn_completadas"
        app:layout_constraintEnd_toStartOf="@id/btn_completadas" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_todas"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Todas"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/purple_main"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/btn_completadas"
        app:layout_constraintBottom_toBottomOf="@id/btn_completadas"
        app:layout_constraintEnd_toStartOf="@id/btn_pendientes" />

    <!-- ========== TARJETA ========== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tareas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey_light"
        app:layout_constraintTop_toTopOf="@id/horizontal2"
        app:layout_constraintBottom_toBottomOf="@id/horizontalpenultima"
        app:layout_constraintStart_toStartOf="@id/vertical1"
        app:layout_constraintEnd_toEndOf="@id/verticalfin" />

    <!-- ========== FILA 1: horizontal2 -> horizontal3 ========== -->
    <CheckBox
        android:id="@+id/cb_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal2"
        app:layout_constraintBottom_toBottomOf="@id/horizontal3"
        app:layout_constraintStart_toStartOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_titulo_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estudiar Android XML"
        android:textColor="#1C1B1F"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal2"
        app:layout_constraintBottom_toTopOf="@id/tv_hora_1"
        app:layout_constraintStart_toEndOf="@id/cb_1"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_hora_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy · 10:00"
        android:textColor="@color/grey_text"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_1"
        app:layout_constraintBottom_toBottomOf="@id/horizontal3"
        app:layout_constraintStart_toStartOf="@id/tv_titulo_1" />

    <ImageView
        android:id="@+id/iv_dots_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@color/grey_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal2"
        app:layout_constraintBottom_toBottomOf="@id/horizontal3"
        app:layout_constraintEnd_toEndOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_prioridad_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alta"
        android:textColor="@color/purple_dark"
        android:textSize="14sp"
        android:background="@drawable/icono"
        android:backgroundTint="@color/purple_light"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/horizontal2"
        app:layout_constraintBottom_toBottomOf="@id/horizontal3"
        app:layout_constraintEnd_toStartOf="@id/iv_dots_1" />

    <!-- ========== FILA 2: horizontal3 -> horizontal4 ========== -->
    <CheckBox
        android:id="@+id/cb_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal3"
        app:layout_constraintBottom_toBottomOf="@id/horizontal4"
        app:layout_constraintStart_toStartOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_titulo_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hacer ejercicio"
        android:textColor="#1C1B1F"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal3"
        app:layout_constraintBottom_toTopOf="@id/tv_hora_2"
        app:layout_constraintStart_toEndOf="@id/cb_2"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_hora_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy · 18:00"
        android:textColor="@color/grey_text"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_2"
        app:layout_constraintBottom_toBottomOf="@id/horizontal4"
        app:layout_constraintStart_toStartOf="@id/tv_titulo_2" />

    <ImageView
        android:id="@+id/iv_dots_2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@color/grey_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal3"
        app:layout_constraintBottom_toBottomOf="@id/horizontal4"
        app:layout_constraintEnd_toEndOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_prioridad_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media"
        android:textColor="@color/green_text"
        android:textSize="14sp"
        android:background="@drawable/icono"
        android:backgroundTint="@color/green_light"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/horizontal3"
        app:layout_constraintBottom_toBottomOf="@id/horizontal4"
        app:layout_constraintEnd_toStartOf="@id/iv_dots_2" />

    <!-- ========== FILA 3: horizontal4 -> horizontal5 ========== -->
    <CheckBox
        android:id="@+id/cb_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal4"
        app:layout_constraintBottom_toBottomOf="@id/horizontal5"
        app:layout_constraintStart_toStartOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_titulo_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leer un libro"
        android:textColor="#1C1B1F"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal4"
        app:layout_constraintBottom_toTopOf="@id/tv_hora_3"
        app:layout_constraintStart_toEndOf="@id/cb_3"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_hora_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mañana · 09:00"
        android:textColor="@color/grey_text"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_3"
        app:layout_constraintBottom_toBottomOf="@id/horizontal5"
        app:layout_constraintStart_toStartOf="@id/tv_titulo_3" />

    <ImageView
        android:id="@+id/iv_dots_3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@color/grey_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal4"
        app:layout_constraintBottom_toBottomOf="@id/horizontal5"
        app:layout_constraintEnd_toEndOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_prioridad_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Baja"
        android:textColor="@color/grey_text"
        android:textSize="14sp"
        android:background="@drawable/icono"
        android:backgroundTint="@color/grey_light"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/horizontal4"
        app:layout_constraintBottom_toBottomOf="@id/horizontal5"
        app:layout_constraintEnd_toStartOf="@id/iv_dots_3" />

    <!-- ========== FILA 4: horizontal5 -> horizontalpenultima ========== -->
    <CheckBox
        android:id="@+id/cb_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal5"
        app:layout_constraintBottom_toBottomOf="@id/horizontalpenultima"
        app:layout_constraintStart_toStartOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_titulo_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preparar la presentación"
        android:textColor="#1C1B1F"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal5"
        app:layout_constraintBottom_toTopOf="@id/tv_hora_4"
        app:layout_constraintStart_toEndOf="@id/cb_4"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_hora_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mañana · 12:00"
        android:textColor="@color/grey_text"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_4"
        app:layout_constraintBottom_toBottomOf="@id/horizontalpenultima"
        app:layout_constraintStart_toStartOf="@id/tv_titulo_4" />

    <ImageView
        android:id="@+id/iv_dots_4"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icono"
        app:tint="@color/grey_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/horizontal5"
        app:layout_constraintBottom_toBottomOf="@id/horizontalpenultima"
        app:layout_constraintEnd_toEndOf="@id/card_tareas" />

    <TextView
        android:id="@+id/tv_prioridad_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alta"
        android:textColor="@color/purple_dark"
        android:textSize="14sp"
        android:background="@drawable/icono"
        android:backgroundTint="@color/purple_light"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/horizontal5"
        app:layout_constraintBottom_toBottomOf="@id/horizontalpenultima"
        app:layout_constraintEnd_toStartOf="@id/iv_dots_4" />

    <!-- ========== BARRA INFERIOR ========== -->
    <View
        android:id="@+id/nav_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/horizontalfin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/nav_linea"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/grey_light"
        app:layout_constraintTop_toTopOf="@id/nav_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nav_inicio"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Inicio"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/purple_dark"
        app:icon="@drawable/icono"
        app:iconGravity="textTop"
        app:iconTint="@color/purple_dark"
        app:layout_constraintTop_toTopOf="@id/horizontalfin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_nav_tareas"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nav_tareas"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Tareas"
        android:textSize="12sp"
        android:textColor="@color/grey_text"
        app:icon="@drawable/icono"
        app:iconGravity="textTop"
        app:iconTint="@color/grey_text"
        app:layout_constraintTop_toTopOf="@id/btn_nav_inicio"
        app:layout_constraintBottom_toBottomOf="@id/btn_nav_inicio"
        app:layout_constraintStart_toEndOf="@id/btn_nav_inicio"
        app:layout_constraintEnd_toStartOf="@id/btn_nav_estadisticas" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nav_estadisticas"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Estadísticas"
        android:textSize="12sp"
        android:textColor="@color/grey_text"
        app:icon="@drawable/icono"
        app:iconGravity="textTop"
        app:iconTint="@color/grey_text"
        app:layout_constraintTop_toTopOf="@id/btn_nav_inicio"
        app:layout_constraintBottom_toBottomOf="@id/btn_nav_inicio"
        app:layout_constraintStart_toEndOf="@id/btn_nav_tareas"
        app:layout_constraintEnd_toStartOf="@id/btn_nav_perfil" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nav_perfil"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Perfil"
        android:textSize="12sp"
        android:textColor="@color/grey_text"
        app:icon="@drawable/icono"
        app:iconGravity="textTop"
        app:iconTint="@color/grey_text"
        app:layout_constraintTop_toTopOf="@id/btn_nav_inicio"
        app:layout_constraintBottom_toBottomOf="@id/btn_nav_inicio"
        app:layout_constraintStart_toEndOf="@id/btn_nav_estadisticas"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== BOTÓN FLOTANTE (siempre al final) ========== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icono"
        app:tint="@android:color/white"
        app:backgroundTint="@color/purple_main"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/horizontalfin"
        app:layout_constraintEnd_toEndOf="@id/verticalfin" />

</androidx.constraintlayout.widget.ConstraintLayout>
    <!-- el botton y el top son para centrar
    el End_toStart es donde termina empezara esl objeto donde estoy usando este
    el Start_toEnd es donde incia el otro termina el objeto donde estoy usando eso-->